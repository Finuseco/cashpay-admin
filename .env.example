# Les secrets réels restent uniquement dans l'environnement du VPS.
NODE_ENV=production
HOST=127.0.0.1
PORT=8010
# Origine HTTPS exacte du back-office, sans chemin. À renseigner.
ADMIN_PUBLIC_ORIGIN=https://admin.cashpay-all.com
# Secret indépendant de Cashpay Web, au moins 32 caractères aléatoires.
ADMIN_SESSION_SECRET=
# Origine des médias publics de Cashpay Web. Ne pas utiliser le domaine admin ici.
CASH_PAY_PUBLIC_ORIGIN=https://app.cashpay-all.com
# Même base et schéma que Cashpay Web ; droits limités de lecture et gestion décrits dans la documentation.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
# Schéma existant de l'application ; aucune migration lancée.
DB_SCHEMA=public
# activer si le serveur PostgreSQL exige TLS ; validation de certificat conservée.
DB_SSL=false
# DB_SSL_CA=certificat CA PEM si nécessaire

# Connexion admin : mêmes paramètres SMTP que Cashpay Web.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Session : 8 heures maximum, 60 minutes d'inactivité.
ADMIN_SESSION_HOURS=8
ADMIN_SESSION_IDLE_MINUTES=60
# Dossier privé persistant, jamais exposé comme racine statique.
ADMIN_STATE_DIR=.runtime

# Notifications de bienvenue : reprendre les paramètres existants du Wallet.
DREAM_DIGITAL_API_URL=
DREAM_DIGITAL_API_ID=
DREAM_DIGITAL_API_PASSWORD=
DREAM_DIGITAL_SENDER_ID=CashPay
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Photos publiques partagées avec Cashpay Web ; configurer explicitement sur le VPS.
# CASH_PAY_AVATAR_DIR=/var/www/cashpay-all/wallet/public/images/avatars
