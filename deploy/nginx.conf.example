# Modèle à adapter et vérifier avec nginx -t ; aucune configuration VPS modifiée ici.
# Cette directive appartient au contexte http (p. ex. conf.d), avant les blocs server.
limit_req_zone $binary_remote_addr zone=cashpay_admin_login:10m rate=5r/m;
server {
    listen 80;
    server_name admin.cashpay-all.com;
    return 301 https://$host$request_uri;
}
server {
    listen 443 ssl;
    server_name admin.cashpay-all.com;
    # Ces certificats doivent exister avant activation de ce modèle.
    ssl_certificate /etc/letsencrypt/live/admin.cashpay-all.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/admin.cashpay-all.com/privkey.pem;
    client_max_body_size 32k;
    location = /api/login {
        limit_req zone=cashpay_admin_login burst=5 nodelay;
        proxy_pass http://127.0.0.1:3102;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 25s;
    }
    location / {
        proxy_pass http://127.0.0.1:3102;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 25s;
    }
}
